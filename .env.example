# ===========================================
# Home Assistant (Twoje dane - falownik Deye)
# ===========================================

# Adres Home Assistant
HA_URL=http://homeassistant.local:8123

# Long-Lived Access Token (HA → Profil → Security → Long-Lived Access Tokens → Utwórz token)
HA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Entity ID sensorów - sprawdź w HA → Developer Tools → States → wyszukaj "deye" lub "solarman"
# Poniżej typowe nazwy dla integracji Solarman/Deye - dostosuj do swoich:
HA_SENSOR_PV_PRODUCTION=sensor.solarman_daily_production
HA_SENSOR_PV_CONSUMPTION=sensor.solarman_daily_load_consumption
HA_SENSOR_PV_EXPORT=sensor.solarman_daily_energy_sell
HA_SENSOR_PV_IMPORT=sensor.solarman_daily_energy_buy
HA_SENSOR_PV_POWER=sensor.solarman_total_active_power
HA_SENSOR_PV_BATTERY_SOC=sensor.solarman_battery_soc
HA_SENSOR_PV_SELF_CONSUMPTION=sensor.solarman_self_consumption_rate

# ===========================================
# FusionSolar (Dane sąsiada - falownik Huawei)
# ===========================================

# Login i hasło do Huawei FusionSolar Northbound API
# (to nie jest zwykły login do FusionSolar, tylko konto Northbound API)
# Tworzenie: FusionSolar → System → Company Management → Northbound Management → Add
FUSIONSOLAR_USER=twoj_northbound_login
FUSIONSOLAR_PASSWORD=twoje_northbound_haslo

# URL API (domyślnie intl, dla EU może być eu5)
# Opcje: https://intl.fusionsolar.huawei.com/thirdData
#         https://eu5.fusionsolar.huawei.com/thirdData
#         https://sg5.fusionsolar.huawei.com/thirdData
FUSIONSOLAR_URL=https://intl.fusionsolar.huawei.com/thirdData

# Station code - opcjonalne, jeśli puste, auto-discovery pierwszej stacji
# Znajdziesz w FusionSolar → Plant list → kliknij na instalację → kod w URL
# FUSIONSOLAR_STATION_CODE=NE=12345678

# ===========================================
# Nazwy graczy
# ===========================================
PLAYER1_NAME=Ja (Deye)
PLAYER2_NAME=Sąsiad (Huawei)

# Port serwera backend
PORT=3001
